{
  "id": "/",
  "name": "Chisme. Did you hear?",
  "short_name": "Chisme",
  "description": "Chisme. Did you hear? Local news, NWS weather, alerts, live rain radar, sports and events for wherever you are, neighborhood stories first.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#00C9CD",
